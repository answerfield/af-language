{
  "name": "@answerfield/compiler",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "out",
    "!out/**/*.map",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "af-source": "./src/index.ts",
      "default": "./out/index.js"
    },
    "./testing": {
      "types": "./out/testing.d.ts",
      "af-source": "./src/testing.ts",
      "default": "./out/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@answerfield/bundle": "https://github.com/answerfield/af-format/releases/download/v0.1.0/answerfield-bundle-0.1.0.tgz",
    "@answerfield/expr": "https://github.com/answerfield/af-format/releases/download/v0.1.0/answerfield-expr-0.1.0.tgz",
    "@answerfield/language": "0.1.0",
    "langium": "~4.4.0",
    "vscode-languageserver-types": "~3.18.0"
  },
  "devDependencies": {
    "@answerfield/conformance": "https://github.com/answerfield/af-format/releases/download/v0.1.0/answerfield-conformance-0.1.0.tgz",
    "@types/node": "^22.0.0",
    "vitest": "^5.0.5",
    "vscode-languageserver-textdocument": "~1.0.13"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/answerfield/af-language",
    "directory": "packages/compiler"
  }
}
